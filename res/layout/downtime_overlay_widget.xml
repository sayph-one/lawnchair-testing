<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/downtime_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="40dp">

    <!-- Logo -->
    <ImageView
        android:id="@+id/downtime_logo"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/sayph_logo"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="32dp" />

    <!-- Heading -->
    <TextView
        android:id="@+id/downtime_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Device is in Downtime"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Routine name -->
    <TextView
        android:id="@+id/downtime_routine_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#B3FFFFFF"
        android:textSize="16sp"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Countdown -->
    <TextView
        android:id="@+id/downtime_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Re-enables in --"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Emergency contacts section header -->
    <TextView
        android:id="@+id/downtime_emergency_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emergency Contacts"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Emergency contacts list (populated programmatically) -->
    <LinearLayout
        android:id="@+id/downtime_contacts_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
